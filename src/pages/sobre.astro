---
import BaseLayout from "../components/BaseLayout.astro";
import { SITE } from "../lib/site";
---

<BaseLayout title="About" description={`About ${SITE.name}.`}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-start">
      <div class="space-y-4">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#ff7a1a]">About</p>
        <h1 class="text-4xl font-semibold leading-[1.02] text-[#fffaf4] sm:text-6xl">{SITE.name}</h1>
      </div>

      <div class="article-content max-w-3xl">
        <p>
          Clinical Inference is a publication about Evidence-Based Medicine, philosophy of evidence,
          and clinical practice.
        </p>
        <p>
          The essays are written for clinicians, researchers, and readers interested in what follows
          after evidence is produced: how it is interpreted, transmitted, trusted, and used at the
          bedside.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
