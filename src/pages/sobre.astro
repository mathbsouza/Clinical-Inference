---
import BaseLayout from "../components/BaseLayout.astro";
import SubscribeCTA from "../components/SubscribeCTA.astro";
import { SITE } from "../lib/site";
---

<BaseLayout title="About" description={`About ${SITE.name}.`}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="space-y-6">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#ff7a1a]">About</p>
      <h1 class="text-5xl font-semibold leading-none text-[#fffaf4] sm:text-7xl">{SITE.name}</h1>
      <div class="article-content">
        <p>
          Clinical Inference is about Evidence-Based Medicine, philosophy, and clinical practice:
          how evidence is produced, how it justifies medical decisions, and what clinicians should do
          when the literature does not speak with one voice.
        </p>
        <p>
          The essays move between trials, guidelines, mechanisms, epistemology, and the everyday
          problem of acting under uncertainty at the bedside.
        </p>
      </div>
    </div>
  </section>

  <SubscribeCTA />
</BaseLayout>
